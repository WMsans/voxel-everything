//!stage     conifers
//!kind      field
//!in        sdf : float
//!in        height : float
//!in        material : uint
//!out       sdf : float
//!out       material : uint
//!param     cell : float = 8.0
//!param     density : float = 0.85
//!param     height_min : float = 18.0
//!param     height_max : float = 28.0
//!param     trunk_radius : float = 0.45
//!param     crown_radius : float = 3.0
//!param     max_slope : float = 1.7
//!param     treeline_margin : float = 40.0
//!use       fjord_height.water_y
//!use       fjord_bands.shore
//!use       fjord_bands.snow_line
//!use       fjord_bands.snow_jitter
//!use       fjord_bands.snow_ridge_drop
//!lipschitz mul 1.0
//!cpu       ve::stage_conifers

// Conifer trunks as real voxels, and the forest material under each crown
// (docs/superpowers/specs/2026-10-08-fjords-conifers-design.md §4.3). Everything about where a
// conifer is and what shape it has lives in shaders/conifer.glslh, which the conifer cull, the
// card scatter, the imposter and the CPU mirror (ve::stage_conifers) all execute too.
//
// Bound: `mul 1.0`. conifer_field returns min(f, max(g(trunks), far bound)); the trunks are
// exact 1-Lipschitz round cones, g (conifer_trunk_field) has slope at most 8.5 and the far
// bound is f scaled by 8.6 / 9.6 < 1, so neither raises the running 8.54
// (the argument cave.field.glslh makes for its max).
//
// Runs AFTER fjord_bands, so the bands' material is known: the forest disc only replaces
// grass and breakstone, and a trunk is bark whatever ground it stands in.

// The guard the conifer cull compiles against (plan deviation 12): only a pipeline with this
// stage defines it, so the cull's body is empty everywhere else.
#define CONIFERS_STAGE 1

vec4 conifer_ground(vec2 xz) { return fjord_ground(xz); }

// The per-brick cell cache. brick_gen.comp.glsl declares the shared arrays (only a compute
// shader may) and defines FIELD_CONIFER_CELL_CACHE before it includes the field. A 0.8 m brick
// sits inside one or two 8 m cells on each axis, so all ~5000 of its lattice points walk the
// same 4x4 cells -- and near the ground nearly every one of them walks, because the far bound
// only clears points ~28 m up and the forest disc is wanted under all grass. Everything a
// walk computes per cell that does not depend on the point (the jittered foot, the grove
// gate, a 16-texel B-spline of ground, the tree's shape: a dozen hashes and the spline) is
// computed once per brick instead. A point whose 3x3 leaves the window walks uncached.
#ifdef FIELD_CONIFER_CELL_CACHE
#define CONIFER_WALK_OVERRIDE conifer_walk_cached
#endif

#include "conifer.glslh"

ConiferParams conifers_params() {
	return conifer_params_make(P.conifers_cell, P.conifers_density, P.conifers_height_min,
			P.conifers_height_max, P.conifers_trunk_radius, P.conifers_crown_radius,
			P.conifers_max_slope, P.conifers_treeline_margin, P.fjord_height_water_y,
			P.fjord_bands_shore, P.fjord_bands_snow_line, P.fjord_bands_snow_jitter,
			P.fjord_bands_snow_ridge_drop, SURFACE_Y);
}

#ifdef FIELD_CONIFER_CELL_CACHE
// Reach past the brick's faces the window covers: the material projection steps at most 2.5
// voxels out and a gradient tap 1 cm, both well inside it.
#define CONIFER_CACHE_MARGIN 0.3
ivec2 g_conifer_cache_base = ivec2(0);
bool g_conifer_cache_on = false;

// Every thread of the workgroup calls this with the brick's WORLD-space corner, then the
// caller barriers. A point within the margin of the brick has its base cell in one of two per
// axis (0.8 + 2 x 0.3 < 8 m) and walks one neighbour either side, so four cells per axis,
// starting one before the lowest base cell, cover every walk.
//   s_conifer_a: foot x, foot z, disc radius (conifer_profile at s = 0) or -1 where no tree
//                stands, trunk radius
//   s_conifer_b: the foot (x, y, z) and the height
void conifer_cell_cache_fill(vec3 world_lo, uint tid) {
	ConiferParams cp = conifers_params();
	vec2 lo = vec2(world_lo.x + VE_FIELD_OFFSET.x, world_lo.z + VE_FIELD_OFFSET.z) -
			vec2(CONIFER_CACHE_MARGIN);
	g_conifer_cache_base = ivec2(int(floor(lo.x / cp.cell)), int(floor(lo.y / cp.cell))) -
			ivec2(1);
	if (tid < 16u) {
		ivec2 cell = g_conifer_cache_base + ivec2(int(tid) % 4, int(tid) / 4);
		vec2 xz = conifer_cell_xz(cell, cp);
		vec4 a = vec4(xz.x, xz.y, -1.0, 0.0);
		vec4 b = vec4(0.0);
		// conifer_walk's per-cell tests, in its order.
		if (conifer_cell_gate(cell, cp)) {
			vec4 g = conifer_ground(xz);
			float slope = sqrt(g.y * g.y + g.z * g.z);
			if (conifer_ground_ok(cp.surface_y + g.x - cp.water_y, slope, cp)) {
				Conifer c = conifer_at(cell, xz, cp.surface_y + g.x, slope, cp);
				a = vec4(xz.x, xz.y, conifer_profile(c, 0.0), c.trunk_r);
				b = vec4(c.foot, c.height);
			}
		}
		s_conifer_a[tid] = a;
		s_conifer_b[tid] = b;
	}
	g_conifer_cache_on = true;
}

// conifer_walk (conifer.glslh), reading each cell from the cache. Same cells, same order,
// same tests; only where the per-cell values come from differs.
ConiferHit conifer_walk_cached(vec3 p, float ground_y, ConiferParams cp, float near_d, bool want_disc) {
	ivec2 base = ivec2(int(floor(p.x / cp.cell)), int(floor(p.z / cp.cell)));
	ivec2 o = base - g_conifer_cache_base;
	if (!g_conifer_cache_on || o.x < 1 || o.y < 1 || o.x > 2 || o.y > 2)
		return conifer_walk(p, ground_y, cp, near_d, want_disc);
	ConiferHit hit;
	hit.d = conifer_d_safe(cp);
	hit.forest = false;
	hit.near = false;
	float trunk_reach = conifer_trunk_reach(cp);
	float disc_reach = conifer_disc_reach(cp);
	float h = p.y - ground_y;
	for (int dz = -1; dz <= 1; dz++) {
		for (int dx = -1; dx <= 1; dx++) {
			int k = (o.y + dz) * 4 + (o.x + dx);
			vec4 a = s_conifer_a[k];
			float hx = p.x - a.x;
			float hz = p.z - a.y;
			float r = sqrt(hx * hx + hz * hz);
			float lb = max(r - trunk_reach, h - CONIFER_FIELD_L * r - cp.height_max);
			bool need_trunk = lb < min(hit.d, near_d);
			bool need_disc = want_disc && !hit.forest && r < disc_reach;
			if (!need_trunk && !need_disc) continue;
			if (a.z < 0.0) continue;
			if (need_trunk) {
				vec4 b = s_conifer_b[k];
				Conifer c;
				c.foot = b.xyz;
				c.height = b.w;
				c.trunk_r = a.w;
				hit.d = min(hit.d, conifer_trunk_sdf(p, c));
			}
			if (need_disc && r <= a.z) hit.forest = true;
		}
	}
	return hit;
}
#endif

void stage_conifers(inout FieldCtx ctx) {
	// A gradient's offset tap whose centre proved the trunks irrelevant (field_ops.glslh).
	if (g_field_skip_detail) return;
	// Deep inside the ground a trunk cannot change the sign, and that material is never seen.
	if (ctx.sdf < -2.0) return;
	bool want_disc = ctx.sdf <= 0.0 &&
			(ctx.material == MAT_GRASS_01 || ctx.material == MAT_BREAKSTONE);
	ConiferHit hit = conifer_field(ctx.p, ctx.sdf, SURFACE_Y + ctx.height, conifers_params(),
			want_disc, FIELD_DETAIL_MARGIN);
	if (hit.near) g_field_detail_near = true;
	ctx.sdf = hit.d;
	// Spec §4.3: bark where the trunk's OWN distance is <= 0 (not the field bound, which is
	// negative underground with no trunk); the forest floor where the disc says so — want_disc
	// already required f <= 0, so the final surface hit.d <= 8.6*f <= 0 there.
	if (hit.trunk_d <= 0.0) ctx.material = MAT_BARK;
	else if (hit.forest) ctx.material = MAT_FOREST;
}
