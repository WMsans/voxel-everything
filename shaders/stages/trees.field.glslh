//!stage     trees
//!kind      field
//!in        sdf : float
//!in        height : float
//!in        material : uint
//!out       sdf : float
//!out       material : uint
//!param     cell : float = 18.0
//!param     density : float = 0.55
//!param     trunk_height : float = 8.0
//!param     trunk_radius : float = 0.55
//!param     branch_radius_min : float = 0.14
//!param     crown_radius : float = 6.0
//!param     max_slope : float = 0.6
//!use       hills.amp_a
//!use       hills.amp_b
//!use       hills.amp_c
//!use       relief.amp_a
//!use       relief.freq_a
//!use       relief.amp_b
//!use       relief.freq_b
//!lipschitz mul 1.0
//!cpu       ve::stage_trees

#include "tree.glslh"

// Trunks and primary branches as real voxels. The geometry itself lives in
// shaders/tree.glslh, shared verbatim with the leaf scatter pass, so the trunk the player
// chops and the canopy drawn above it can never disagree about where a tree is.
//
// Bound: this stage does `sdf = min(sdf, tree_d)` where tree_d is an exact union of
// 1-Lipschitz round cones. min(a, b) is bounded by max of the two operands' bounds, and the
// running bound here is 1.99 >= 1, so the union cannot raise it -- the same argument
// cave.field.glslh makes for its max. Hence `mul 1.0`.
//
// Runs AFTER height_bands: the band stage would otherwise paint a trunk by the ground height
// at its foot, so a trunk on high ground would come out rock.
//
// Cost: this is evaluated at every voxel of every brick, so the three early-outs below are
// load-bearing, not tidiness. The vertical band does nearly all the work.

// Terrain height above SURFACE_Y at an arbitrary XZ. This is hills + relief recomputed at a
// point that is NOT ctx.p, which is why the hills and relief params are declared //!use --
// exactly the pattern cave.field.glslh established for its sphere centre.
float trees_ground_h(vec2 xz) {
	float h = P.hills_amp_a * sin(xz.x * 0.11) * cos(xz.y * 0.13)
	        + P.hills_amp_b * sin(xz.x * 0.031 + 1.7) * sin(xz.y * 0.043)
	        + P.hills_amp_c * sin(xz.x * 0.23 + xz.y * 0.19);
	float r = P.relief_amp_a * sin(xz.x * P.relief_freq_a) * cos(xz.y * P.relief_freq_a)
	        + P.relief_amp_b * sin(xz.x * P.relief_freq_b) * cos(xz.y * P.relief_freq_b);
	return h + r;
}

// |grad| of the above, in closed form. No marching, no sampling: a tree either stands on
// ground flat enough or the cell carries no tree at all.
float trees_ground_slope(vec2 xz) {
	float dx = P.hills_amp_a * 0.11 * cos(xz.x * 0.11) * cos(xz.y * 0.13)
	         + P.hills_amp_b * 0.031 * cos(xz.x * 0.031 + 1.7) * sin(xz.y * 0.043)
	         + P.hills_amp_c * 0.23 * cos(xz.x * 0.23 + xz.y * 0.19)
	         + P.relief_amp_a * P.relief_freq_a * cos(xz.x * P.relief_freq_a) * cos(xz.y * P.relief_freq_a)
	         + P.relief_amp_b * P.relief_freq_b * cos(xz.x * P.relief_freq_b) * cos(xz.y * P.relief_freq_b);
	float dz = -P.hills_amp_a * 0.13 * sin(xz.x * 0.11) * sin(xz.y * 0.13)
	         + P.hills_amp_b * 0.043 * sin(xz.x * 0.031 + 1.7) * cos(xz.y * 0.043)
	         + P.hills_amp_c * 0.19 * cos(xz.x * 0.23 + xz.y * 0.19)
	         - P.relief_amp_a * P.relief_freq_a * sin(xz.x * P.relief_freq_a) * sin(xz.y * P.relief_freq_a)
	         - P.relief_amp_b * P.relief_freq_b * sin(xz.x * P.relief_freq_b) * sin(xz.y * P.relief_freq_b);
	return length(vec2(dx, dz));
}

TreeParams trees_params() {
	TreeParams tp;
	tp.cell = P.trees_cell;
	tp.density = P.trees_density;
	tp.trunk_height = P.trees_trunk_height;
	tp.trunk_radius = P.trees_trunk_radius;
	tp.branch_radius_min = P.trees_branch_radius_min;
	tp.crown_radius = P.trees_crown_radius;
	tp.max_slope = P.trees_max_slope;
	return tp;
}

void stage_trees(inout FieldCtx ctx) {
	// A gradient's offset tap whose centre proved the trees irrelevant (field_ops.glslh).
	if (g_field_skip_detail) return;
	TreeParams tp = trees_params();

	// EARLY-OUT 1, the vertical band. ctx.height is the terrain height at THIS point's XZ,
	// already published by hills and relief, so it is free. Everything more than a couple of
	// metres below the ground or a whole tree above it is finished in one compare.
	float ground_y = SURFACE_Y + ctx.height;
	// The plane must clear not just the geometry (H = trunk_height * 1.25 + crown_radius) but
	// the terrain height field the point is compared against: in the slab above the ground the
	// running 1.99 bound lets f exceed 1.99 * d_tree, up to h ~= 2.0101 * H. Round that slab
	// bound (x1.99) up to 2.05 for margin. Kept IDENTICAL to the CPU mirror in builtin_stages.cpp.
	float band_top = ground_y + 2.05 * (tp.trunk_height * 1.25 + tp.crown_radius);
	if (ctx.p.y < ground_y - 2.0 || ctx.p.y > band_top) {
		// Within a tap of the band's edge a neighbouring tap may be inside it; ground_y moves
		// with XZ too, so the allowance is the full FIELD_DETAIL_MARGIN.
		if (ctx.p.y > ground_y - 2.0 - FIELD_DETAIL_MARGIN && ctx.p.y < band_top + FIELD_DETAIL_MARGIN)
			g_field_detail_near = true;
		return;
	}

	ivec2 base = ivec2(int(floor(ctx.p.x / tp.cell)), int(floor(ctx.p.z / tp.cell)));
	float d = tree_d_safe(tp);
	// 0.05 m of slack so float rounding can only make EARLY-OUT 0 skip less than the exact
	// bound, never more. Kept IDENTICAL to the CPU mirror in builtin_stages.cpp.
	float reach = tp.crown_radius + TREE_MAX_LEAN * tp.trunk_height * 1.25 + 0.05;
	// Which neighbours to visit at all. Measured: the nine-cell sweep's hashes alone, run at
	// seven gradient taps per near-field pixel, were a quarter of the frame. A tree's foot
	// never leaves its cell's TREE_JITTER box, so a neighbour whose box is further than
	// `sweep` from this point on either axis would fail EARLY-OUT 0 for every foot it could
	// hold -- skip it without hashing. `sweep` uses d before the loop lowers it and another
	// 0.05 m of slack, so this visits a superset of the cells EARLY-OUT 0 lets through, in
	// the same order. Kept IDENTICAL to the CPU mirror.
	// Every reject below compares against `near_d`, not ctx.sdf: a tree further than the
	// terrain plus FIELD_DETAIL_MARGIN cannot win here, which is all the result needs, and
	// cannot win one gradient tap away either, which is what g_field_detail_near reports.
	float near_d = ctx.sdf + FIELD_DETAIL_MARGIN;
	float sweep = reach + min(d, near_d) + 0.05;
	float gap = (0.5 - TREE_JITTER) * tp.cell;
	float fx = ctx.p.x - float(base.x) * tp.cell;
	float fz = ctx.p.z - float(base.y) * tp.cell;
	int dx_lo = (fx + gap < sweep) ? -1 : 0;
	int dx_hi = (tp.cell - fx + gap < sweep) ? 1 : 0;
	int dz_lo = (fz + gap < sweep) ? -1 : 0;
	int dz_hi = (tp.cell - fz + gap < sweep) ? 1 : 0;
	for (int dz = dz_lo; dz <= dz_hi; dz++) {
		for (int dx = dx_lo; dx <= dx_hi; dx++) {
			ivec2 cell = base + ivec2(dx, dz);
			vec2 xz = tree_cell_xz(cell, tp);
			// EARLY-OUT 0, the horizontal reach: hashes only, before any trig. A tree's
			// geometry stays within `reach` of its foot in XZ (crown radius plus the lean
			// cap tree_d_safe() also subtracts), so its distance is at least this, and a
			// tree no closer than the terrain (`near_d`) or the running d cannot change the
			// result below. This matters most where the field is sampled most: surface hit
			// points, where ctx.sdf ~ 0 and nearly every cell dies here.
			if (distance(ctx.p.xz, xz) - reach >= min(d, near_d)) continue;
			// EARLY-OUT 2, the forest gate, cheapest test first: hashes, then the height band
			// (the rejection spec §4 asks for), and only then the analytic slope, which
			// tree_cell_present checks inside tree_at.
			if (!tree_cell_gate(cell, tp)) continue;
			float gh = trees_ground_h(xz);
			if (!tree_height_ok(gh)) continue;
			Tree t = tree_at(cell, tp, SURFACE_Y + gh, gh, trees_ground_slope(xz));
			if (!t.present) continue;
			// EARLY-OUT 3, the bound (tree_bound_tight in tree.glslh). Never greater than the skeleton distance, so
			// this cannot drop a cell the skeleton would have claimed.
			if (tree_bound_tight(ctx.p, t, tp) >= min(d, near_d)) continue;
			d = min(d, tree_skeleton_sdf(ctx.p, t, tp));
		}
	}

	if (d < near_d) g_field_detail_near = true;
	if (d < ctx.sdf) {
		ctx.sdf = d;
		if (d <= 0.0) ctx.material = MAT_BARK;
	}
}
