//!stage     fjord_water
//!kind      field
//!in        sdf : float
//!in        material : uint
//!out       sdf : float
//!out       material : uint
//!out       ground_sdf : float
//!out       ground_material : uint
//!out       liquid_level : float
//!use       fjord_height.water_y
//!lipschitz mul 1.0
//!cpu       ve::stage_fjord_water

// Calm sea at the fjords' water level W: copies the ground into the reserved
// channels, then folds the half-space below W into the union as water.

void stage_fjord_water(inout FieldCtx ctx) {
	ctx.ground_sdf = ctx.sdf;
	ctx.ground_material = ctx.material;
	ctx.liquid_level = P.fjord_height_water_y;
	float w = ctx.p.y - P.fjord_height_water_y;
	if (ctx.ground_sdf > 0.0 && w <= 0.0) {
		ctx.sdf = w;
		ctx.material = MAT_WATER;
	}
}