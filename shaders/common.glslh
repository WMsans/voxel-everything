// Shared constants + helpers, pulled into every voxel shader by ve::load_shader_source.
// NOTE: never put a literal include directive inside a comment in this file — the loader
// matches include tokens anywhere in a line and would self-include (cycle error).
const int BRICK_VOXELS = 16;
const float VOXEL_SIZE = 0.05;
const float BRICK_SIZE = 0.8;         // 16 * 0.05
const float SDF_RANGE = 0.64;         // uint8 unorm <-> [-0.64, 0.64]
// Mirrors ve::kActivationPad and the CPU consumer-specific filter pads in world/brick.h.
const float ACTIVATION_PAD = 0.15;
const float BRICK_FILTER_PAD = ACTIVATION_PAD + VOXEL_SIZE;
const float LATTICE_FILTER_PAD = VOXEL_SIZE + SDF_RANGE;
#include "material_table.glslh"
const int REGION_BRICKS = 32;
const float REGION_SIZE = 25.6;       // 32 * 0.8
const int REGION_BRICK_COUNT = 32768; // 32^3
const int OCC_WORDS_PER_REGION = REGION_BRICK_COUNT / 16; // 2048

// The SDF atlas stores a 17^3 LATTICE per brick: sample n sits at local coordinate n, and
// the extra plane at 16 is a one-voxel apron so trilinear reconstruction covers the brick's
// whole [0,16) extent. Without it the last slab clamps to a constant, the gradient collapses,
// and shading seams appear on every brick face. The material atlas is a plain 16^3 cell grid
// (nearest filtered, no apron).
const int BRICK_SDF_STRIDE = BRICK_VOXELS + 1; // 17
const int BRICK_VOXEL_COUNT = 4096;            // 16^3
const int BRICK_SDF_COUNT = 4913;              // 17^3
const float BRICK_SDF_MAX = float(BRICK_VOXELS); // last valid lattice coordinate

// A cell of the min-max chain holds no surface unless its range straddles this value.
// It is exactly ve::encode_sdf(0.0f).
const uint ENCODED_ZERO = 128u;
const uint BRICK_FLAG_HAS_SURFACE = 1u;
const uint BRICK_FLAG_HAS_MATERIAL = 2u;
const uint BRICK_FLAG_CONSERVATIVE = 3u;

// Field constants. They live here (not in field_ops.glslh) because the terrain pipeline's
// generated field.glslh emits its stage bodies BEFORE the field_ops prelude, and a stage
// body referencing SURFACE_Y would otherwise read it before its declaration. Every
// field.glslh includer pulls common.glslh in first, so both the stub and the generated
// source see these before any field code.
const uint OP_SPHERE_SUBTRACT = 0u;
const uint OP_SPHERE_ADD = 1u;
const uint OP_SPHERE_PAINT = 2u;
const uint OP_BOX_SUBTRACT = 3u;
const uint OP_VOLUME_ADD = 4u;
const uint MAX_REGION_OPS = 256u;
// ve::kOccupancyCellSize -- a box op's extent is counted in 0.8 m occupancy cells.
const float OCCUPANCY_CELL_SIZE = 0.8;
// ve::kIslandDim ^ 3: the per-slot stride of both volume buffers. render/volume_pool.cpp
// static_asserts that this matches, so changing the C++ constant breaks the BUILD.
const int VOLUME_VOXELS = 262144;
// Mirror of ve::kSurfaceY (extension/src/generator/generator.h): 51.2 = -origin_bricks.y *
// kBrickSize for the default world origin (0, -64, 0). Must stay in lockstep with the CPU
// constant; tests/test_field_diff.gd guards the agreement.
const float SURFACE_Y = 51.2;

float decode_sdf(float unorm) { return unorm * 2.0 * SDF_RANGE - SDF_RANGE; }

// The BYTE ve::encode_sdf produces. Quantising here rather than leaning on the hardware's
// float->unorm conversion removes the only rounding-mode difference between CPU and GPU.
uint encode_sdf_byte(float d) {
	float t = clamp((d + SDF_RANGE) / (2.0 * SDF_RANGE), 0.0, 1.0);
	return uint(floor(t * 255.0 + 0.5));
}

// The float an R8_UNORM imageStore must receive for the written byte to equal
// ve::encode_sdf(d).
float quantise_sdf(float d) { return float(encode_sdf_byte(d)) / 255.0; }

// The far-field and unknown-layer fallback, read from the generated table so it cannot
// drift from ve::kMaterials. An id with no entry stays error magenta.
vec3 flat_material_albedo(uint mat_id) {
	int i = int(mat_id) - 1;
	if (i < 0 || i >= MATERIAL_COUNT) return vec3(1.0, 0.0, 1.0);
	return MAT_FLAT_ALBEDO[i];
}

vec3 sky_color(vec3 dir) {
	float t = clamp(dir.y * 0.5 + 0.5, 0.0, 1.0);
	return mix(vec3(0.55, 0.45, 0.35), vec3(0.25, 0.45, 0.85), t);
}

// One world tile every 2 m. Mips then do the distance work for free: at 2 km a 2 m tile is
// sub-pixel and resolves to the top mip's average, which is what makes the far field look
// right with no bake at all (spec section 5).
const float MATERIAL_UV_SCALE = 0.5;

// The includer must declare these before including, at bindings it owns:
//   layout(set = ?, binding = ?) uniform sampler2DArray material_albedo;
//   layout(set = ?, binding = ?) uniform sampler2DArray material_surface_tex;
// and define MATERIAL_LAYERS to the array's layer count.

// A 4x4 Bayer threshold in [0, 1). It is independent of material layers and is shared by
// the screen-space beauty masks as well as the terrain shaders.
float bayer4(ivec2 px) {
	const int M[16] = int[16](0, 8, 2, 10, 12, 4, 14, 6, 3, 11, 1, 9, 15, 7, 13, 5);
	return float(M[(px.y & 3) * 4 + (px.x & 3)]) / 16.0;
}

#ifdef MATERIAL_LAYERS

// Triplanar with EXPLICIT gradients. The raymarcher is a compute shader and has no
// dFdx/dFdy, so it supplies gradients from ray differentials while the LoD fragment shader
// supplies dFdx(wpos)/dFdy(wpos). Without this the near field either aliases or over-blurs
// and the seam becomes a visible sharpness step -- the one artefact this whole approach
// exists to avoid.
//
// Returns albedo in rgb and height in a. Material 0 is air; anything without a layer shades
// error magenta, matching flat_material_albedo()'s default.
vec4 material_surface(uint mat, vec3 p, vec3 n, vec3 ddx, vec3 ddy) {
	int layer = int(mat) - 1;
	if (layer < 0 || layer >= MATERIAL_LAYERS) return vec4(1.0, 0.0, 1.0, 0.0);
	vec3 an = abs(n);
	vec3 w = an / max(an.x + an.y + an.z, 1e-5);
	float s = MATERIAL_UV_SCALE;
	vec4 cx = textureGrad(material_albedo, vec3(p.zy * s, float(layer)), ddx.zy * s, ddy.zy * s);
	vec4 cy = textureGrad(material_albedo, vec3(p.xz * s, float(layer)), ddx.xz * s, ddy.xz * s);
	vec4 cz = textureGrad(material_albedo, vec3(p.xy * s, float(layer)), ddx.xy * s, ddy.xy * s);
	return cx * w.x + cy * w.y + cz * w.z;
}

// How hard the material normal map bends the shading normal. 1.0 is "exactly as authored":
// the maps in assets/materials are ordinary tangent-space art, and the whiteout blend below
// returns the geometric normal EXACTLY under a flat map, so full strength cannot put a tilt
// on a surface whose map says nothing. Lower it to soften relief; 0.0 restores the pre-Task-11
// behaviour where the map was packed into the atlas and read by nothing.
const float MATERIAL_NORMAL_STRENGTH = 1.0;

// The normal map, blended across the same three planes the albedo uses. Triplanar normals
// cannot simply be averaged: each projection's map is written in ITS OWN tangent frame, so
// the +Z of the zy plane means +X in the world and adding the three raw vectors points
// nowhere in particular. This is the "whiteout" blend -- fold the geometric normal into each
// projection's frame, add the map's tilt there, then swizzle each result back to world space
// before the triplanar weights combine them.
//
// Two consequences worth keeping: a flat map (XY = 0, so Z = 1) reduces to the geometric
// normal exactly, and the blend never flips a face, because the projection's own axis is
// carried by abs(z) * n.<axis> and keeps the geometric sign.
//
// Only XY is stored (render/material_atlas.cpp pack_layer), so Z is reconstructed. A mip
// average shortens XY, and beyond unit length the max() keeps the square root real: the
// normal simply flattens toward geometric, which is what an averaged-away map should do.
vec3 triplanar_normal(vec2 tx, vec2 ty, vec2 tz, vec3 n, vec3 w) {
	float k = MATERIAL_NORMAL_STRENGTH;
	vec2 ex = (tx * 2.0 - 1.0) * k;
	vec2 ey = (ty * 2.0 - 1.0) * k;
	vec2 ez = (tz * 2.0 - 1.0) * k;
	vec3 nx = vec3(ex, sqrt(max(1.0 - dot(ex, ex), 0.0)));
	vec3 ny = vec3(ey, sqrt(max(1.0 - dot(ey, ey), 0.0)));
	vec3 nz = vec3(ez, sqrt(max(1.0 - dot(ez, ez), 0.0)));
	// The plane each projection samples: x <- p.zy, y <- p.xz, z <- p.xy, matching
	// material_surface() and material_props() texel for texel.
	nx = vec3(nx.xy + n.zy, abs(nx.z) * n.x);
	ny = vec3(ny.xy + n.xz, abs(ny.z) * n.y);
	nz = vec3(nz.xy + n.xy, abs(nz.z) * n.z);
	vec3 b = nx.zyx * w.x + ny.xzy * w.y + nz.xyz * w.z;
	float l = length(b);
	return l > 1e-5 ? b / l : n;
}

// The other half of the material: the shading normal, roughness and ambient occlusion, all
// triplanar-weighted exactly like the albedo so a cliff face and a flat top read the same
// numbers. The channel packing is render/material_atlas.cpp's pack_layer(): normal XY,
// roughness in B, AO in A. M5 loaded this array and sampled none of it; M6 took the roughness
// and the AO; Task 11 took the normal, which is what gave terrain any relief finer than a
// voxel.
//
// `shading_normal` comes back as the geometric normal `n` for a material with no layer, and
// under a flat map, so a caller may write it to the G-buffer unconditionally. The three
// fetches serve all three outputs: reading the map costs no extra texture traffic.
vec2 material_props_normal(uint mat, vec3 p, vec3 n, vec3 ddx, vec3 ddy, out vec3 shading_normal) {
	shading_normal = n;
	int layer = int(mat) - 1;
	if (layer < 0 || layer >= MATERIAL_LAYERS) return vec2(1.0, 1.0); // rough, unoccluded
	vec3 an = abs(n);
	vec3 w = an / max(an.x + an.y + an.z, 1e-5);
	float s = MATERIAL_UV_SCALE;
	vec4 cx = textureGrad(material_surface_tex, vec3(p.zy * s, float(layer)), ddx.zy * s, ddy.zy * s);
	vec4 cy = textureGrad(material_surface_tex, vec3(p.xz * s, float(layer)), ddx.xz * s, ddy.xz * s);
	vec4 cz = textureGrad(material_surface_tex, vec3(p.xy * s, float(layer)), ddx.xy * s, ddy.xy * s);
	shading_normal = triplanar_normal(cx.rg, cy.rg, cz.rg, n, w);
	vec4 c = cx * w.x + cy * w.y + cz * w.z;
	return vec2(c.b, c.a);
}

// Roughness and AO alone, for the callers that have no normal to bend: the raymarcher's
// glossy-ray gate (which reflects about the GEOMETRIC normal it marched with) and the debug
// material probe. The blend above feeds nothing here, so it compiles out.
vec2 material_props(uint mat, vec3 p, vec3 n, vec3 ddx, vec3 ddy) {
	vec3 unused;
	return material_props_normal(mat, p, n, ddx, ddy, unused);
}

// shade_terrain() lived here until M6. Lighting now happens exactly once, in
// shaders/deferred.comp.glsl via cel_shade() in shade.glslh. Do not add a second one.

#endif
