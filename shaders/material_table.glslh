	0u, // ground_crack_01
	0u, // ice_crack
	0u, // ice
	0u, // bark
	1u, // water
	0u, // snow
	0u // forest
);

// Foliage (ve::kFoliage): ids FOLIAGE_BASE + k. No atlas layer and no flat albedo -- a
// foliage raster writes its own colour -- so only the emission tables exist.
const uint FOLIAGE_BASE = 200u;
const int FOLIAGE_COUNT = 2;
const uint MAT_GRASS_BLADE = 200u;
const uint MAT_LEAF_CLUMP = 201u;

const float FOLIAGE_GLOW[FOLIAGE_COUNT] = float[FOLIAGE_COUNT](
	0.000000, // grass_blade
	0.000000 // leaf_clump
);

const vec3 FOLIAGE_GLOW_RGB[FOLIAGE_COUNT] = vec3[FOLIAGE_COUNT](
	vec3(0.000000, 0.000000, 0.000000), // grass_blade
	vec3(0.000000, 0.000000, 0.000000) // leaf_clump
);

// Mirror of ve::material_glow, including its fail-soft rule: air and any id with
// no table entry emit nothing. There is deliberately no hardness here -- a removal's
// size is resolved once on the CPU by ve::removal_radius before the op is uploaded,
// so every field sample sees one shape and no shader ever looks hardness up.
float mat_glow(uint id) {
	int i = int(id) - 1;
	if (i >= 0 && i < MATERIAL_COUNT) return MAT_GLOW[i];
	int j = int(id) - int(FOLIAGE_BASE);
	return (j >= 0 && j < FOLIAGE_COUNT) ? FOLIAGE_GLOW[j] : 0.0;
}

vec3 mat_glow_rgb(uint id) {
	int i = int(id) - 1;
	if (i >= 0 && i < MATERIAL_COUNT) return MAT_GLOW_RGB[i];
	int j = int(id) - int(FOLIAGE_BASE);
	return (j >= 0 && j < FOLIAGE_COUNT) ? FOLIAGE_GLOW_RGB[j] : vec3(0.0);
}

// Mirror of ve::material_transparent: air, foliage and any id with no table entry are
// opaque. Transparent means any channel of the per-metre transmittance is above zero.
bool mat_transparent(uint id) {
	int i = int(id) - 1;
	return i >= 0 && i < MATERIAL_COUNT && any(greaterThan(MAT_TRANSMIT[i], vec3(0.0)));
}

vec3 mat_transmit(uint id) {
	int i = int(id) - 1;
	return (i >= 0 && i < MATERIAL_COUNT) ? MAT_TRANSMIT[i] : vec3(0.0);
}

float mat_ior(uint id) {
	int i = int(id) - 1;
	return (i >= 0 && i < MATERIAL_COUNT) ? MAT_IOR[i] : 1.0;
}

// Mirror of ve::material_liquid: air, foliage and any id with no row are not liquids.
uint mat_liquid(uint id) {
	int i = int(id) - 1;
	return (i >= 0 && i < MATERIAL_COUNT) ? MAT_LIQUID[i] : LIQUID_NONE;
}
