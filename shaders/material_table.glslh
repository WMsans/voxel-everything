// Liquids (ve::Liquid). A liquid is transparent AND a ghost: the solid view treats it
// as air. Only the transparency composite asks WHICH liquid.
const uint LIQUID_NONE = 0u;
const uint LIQUID_WATER = 1u;

const uint MAT_LIQUID[MATERIAL_COUNT] = uint[MATERIAL_COUNT](
	0u, // grass_01
	0u, // rock
	0u, // ground_01
