// Shared tree definition: where trees are, what shape they have, and their SDF.
//
// ONE definition, TWO consumers: shaders/stages/trees.field.glslh unions the capsules into
// the terrain field, and shaders/leaf_scatter.comp.glsl scatters canopy clumps around the
// branch tips. They read the same P.trees_* params from the terrain pipeline's set 1, so the
// trunk you chop and the canopy you see cannot disagree.
//
// This header knows NOTHING about terrain. Ground height and slope at a tree's XZ are
// supplied by the caller, which is what lets extension/tests/test_tree_shader.cpp execute it
// natively with no pipeline.
//
// NOTE: never put a literal include directive inside a comment in this file -- the loader
// matches include tokens anywhere in a line and would self-include.

// Trunk jitter within its cell, as a fraction of the cell size, measured from the centre.
// Bounded so tree_d_safe() below can be derived from it: a tree NEVER leaves its own cell.
#define TREE_JITTER 0.35

struct TreeParams {
	float cell;               // placement lattice pitch, metres
	float density;            // fraction of cells that carry a tree, 0..1
	float trunk_height;       // mean trunk length, metres
	float trunk_radius;       // trunk radius at the foot, metres
	float branch_radius_min;  // radius at a branch tip, metres
	float crown_radius;       // crown bounding radius AND the SDF bound radius, metres
	float max_slope;          // reject a cell whose ground slope exceeds this
};

// PCG-style integer hash, the same one grass.glslh uses. Integer-only by requirement: the
// CPU mirror and this GLSL must agree bit-for-bit, and a float hash chain does not.
uint tree_hash(uint x) {
	x = x * 747796405u + 2891336453u;
	uint w = ((x >> ((x >> 28u) + 4u)) ^ x) * 277803737u;
	return (w >> 22u) ^ w;
}

uint tree_hash2(ivec2 c, uint salt) {
	return tree_hash(uint(c.x) * 73856093u ^ uint(c.y) * 19349663u ^ salt);
}

float tree_unit(uint h) { return float(h & 0x00FFFFFFu) / float(0x01000000u); }
float tree_snorm(uint h) { return tree_unit(h) * 2.0 - 1.0; }

// The jittered trunk XZ for a cell. Always inside the cell's TREE_JITTER box, which is what
// tree_d_safe() depends on.
vec2 tree_cell_xz(ivec2 cell, TreeParams tp) {
	float jx = tree_snorm(tree_hash2(cell, 0x9E37u)) * TREE_JITTER * tp.cell;
	float jz = tree_snorm(tree_hash2(cell, 0x85EBu)) * TREE_JITTER * tp.cell;
	return vec2((float(cell.x) + 0.5) * tp.cell + jx,
	            (float(cell.y) + 0.5) * tp.cell + jz);
}

// Forest gate plus slope and height-band rejection. `slope` is |grad h| at the tree's XZ and
// `h` is the terrain height there above SURFACE_Y, both supplied by the caller -- this header
// stays terrain-free. Low-frequency lattice noise on the cell grid gives groves and clearings
// rather than an orchard: neighbouring cells share a gate value, so trees arrive in clumps.
bool tree_cell_present(ivec2 cell, TreeParams tp, float h, float slope) {
	if (slope > tp.max_slope) return false;
	// SPEC §4 HEIGHT BAND: trees grow on grass and nowhere else. The window mirrors
	// stage_height_bands (shaders/stages/height_bands.field.glslh: rock above 4, grass above
	// 1, dirt below), whose gates are stage text rather than pipeline params, so copying the
	// literals cannot diverge from an author's edit. Kept IDENTICAL to the CPU mirror in
	// extension/src/terrain/builtin_stages.cpp; test_field_diff.gd pins the two together.
	if (h <= 1.0 || h > 4.0) return false;
	// Grove noise: bilinear value noise on a 4-cell lattice, so a grove is ~56 m across.
	ivec2 g = ivec2(int(floor(float(cell.x) * 0.25)), int(floor(float(cell.y) * 0.25)));
	float fx = float(cell.x) * 0.25 - floor(float(cell.x) * 0.25);
	float fz = float(cell.y) * 0.25 - floor(float(cell.y) * 0.25);
	fx = fx * fx * (3.0 - 2.0 * fx);
	fz = fz * fz * (3.0 - 2.0 * fz);
	float a = tree_unit(tree_hash2(g, 0x1A2Bu));
	float b = tree_unit(tree_hash2(g + ivec2(1, 0), 0x1A2Bu));
	float c = tree_unit(tree_hash2(g + ivec2(0, 1), 0x1A2Bu));
	float d = tree_unit(tree_hash2(g + ivec2(1, 1), 0x1A2Bu));
	float grove = mix(mix(a, b, fx), mix(c, d, fx), fz);
	// The grove field biases the per-cell draw: dense in a grove, sparse in a clearing.
	// Centred on 1.0 so `density` still means "this fraction of cells, on average".
	float draw = tree_unit(tree_hash2(cell, 0x2F1Du));
	return draw < tp.density * (0.35 + 1.3 * grove);
}

// Five primaries, each splitting once: ten branch tips, ten canopy lobes. The count is a
// compile-time constant because both consumers unroll over it, and because a 5 cm voxel grid
// cannot resolve more branch levels than this anyway -- see the design doc's risk table.
#define TREE_PRIMARIES 5
#define TREE_LOBES 10

struct Tree {
	vec3 base;      // trunk foot, world space
	float height;   // trunk length
	float radius;   // trunk radius at the foot
	vec3 crown;     // crown centre, world space
	float crown_r;  // crown bounding radius; bounds every lobe AND every capsule
	uint hash;      // per-tree hash: colour, phase, species jitter
	bool present;
};

// --- trunk shape ---------------------------------------------------------------------
// The SDF skeleton is DELIBERATELY coarser than the canopy: TREE_LOBES lobes of leaves, but
// only TREE_LIMBS limbs of wood. In the references a crown hides its own branching almost
// entirely -- you read the bole and one or two limbs, never ten. Carrying ten in the field
// cost 21 round cones per tree at every voxel to draw detail nobody sees; this carries 11.

// Limbs in the SDF. Four, so that two are visible from any azimuth.
#define TREE_LIMBS 4
// Trunk curve segments. Three is what it takes to rise plumb and still lean at the top.
#define TREE_TRUNK_SEGS 3
// Horizontal offset of the crown from the foot, as a fraction of trunk height. This is a
// HARD cap, not a typical value: tree_d_safe() subtracts it, so raising it here without
// raising it there understates the clamp and tunnels the raymarcher.
#define TREE_MAX_LEAN 0.15

// A point on the trunk axis, s in 0..1 from foot to crown centre. Quadratic Bezier whose
// control point sits directly above the FOOT, which is what makes the trunk leave the
// ground vertically and accumulate its lean higher up -- a straight tilted pole reads as a
// fallen post, not a tree.
vec3 tree_trunk_point(Tree t, float s) {
	vec3 ctrl = vec3(t.base.x, mix(t.base.y, t.crown.y, 0.55), t.base.z);
	float u = 1.0 - s;
	return t.base * (u * u) + ctrl * (2.0 * u * s) + t.crown * (s * s);
}

// Trunk radius at s. Two factors: a root flare that dies out by 15% height, and a steady
// taper the whole way up. Monotone decreasing by construction -- a bulge anywhere would
// show as a swollen joint.
float tree_trunk_radius(Tree t, float s) {
	float flare = mix(1.55, 1.0, clamp(s / 0.15, 0.0, 1.0));
	float taper = mix(1.0, 0.30, s);
	return t.radius * flare * taper;
}

// Where limb i leaves the trunk, as s along the curve. Each limb owns its own slice of the
// 0.28..0.62 band and jitters only WITHIN that slice, so no two limbs can ever share a fork
// point. That shared point is precisely what made the old skeleton read as a broom.
float tree_limb_fork(Tree t, int i) {
	uint h = tree_hash(t.hash ^ (uint(i) * 0x27D4EB2Du));
	float slot = float(i) / float(TREE_LIMBS);
	// The jitter spans 0.6 of a slice, never the whole slice, so adjacent limbs keep a
	// guaranteed 0.4-slice gap: 0.1 in slot space, 0.034 in s. A full-width jitter leaves
	// only 0.0085 and two limbs can then fork from what reads as the same point.
	return mix(0.28, 0.62, slot + tree_unit(h) * (0.6 / float(TREE_LIMBS)));
}

// `ground_y`, `ground_h` (terrain height above SURFACE_Y at the tree's XZ) and `slope` come
// from the caller (the stage evaluates hills+relief at the tree's XZ; the leaf scatter does
// the same). This header stays terrain-free.
Tree tree_at(ivec2 cell, TreeParams tp, float ground_y, float ground_h, float slope) {
	Tree t;
	t.hash = tree_hash2(cell, 0xC2B2u);
	t.present = tree_cell_present(cell, tp, ground_h, slope);
	vec2 xz = tree_cell_xz(cell, tp);
	t.base = vec3(xz.x, ground_y, xz.y);
	// +-25% height, +-20% radius. Variety comes from the hash; there is one species.
	t.height = tp.trunk_height * (1.0 + 0.25 * tree_snorm(tree_hash(t.hash ^ 0x51u)));
	t.radius = tp.trunk_radius * (1.0 + 0.20 * tree_snorm(tree_hash(t.hash ^ 0x52u)));
	// The crown sits at the top of the trunk. Its radius scales with the trunk's own height
	// jitter so a tall tree gets a proportionally large crown, and is CLAMPED to
	// tp.crown_radius because tree_d_safe() (Task 3) is derived from that number.
	t.crown_r = min(tp.crown_radius, tp.crown_radius * t.height / max(tp.trunk_height, 1e-3));
	// Lean. A trunk is not a plumb line, and a forest of plumb lines reads as a lamppost
	// farm -- see the references in the 2026-09-19 trunk reshape. Direction is free, but the
	// MAGNITUDE is capped at TREE_MAX_LEAN * height so tree_d_safe() can subtract a known
	// worst case: a leaning crown reaches further from the cell centre than an upright one,
	// and understating that clamp is the direction that tunnels the raymarcher.
	float lean_az = tree_unit(tree_hash(t.hash ^ 0x53u)) * 6.2831853;
	float lean_m = TREE_MAX_LEAN * t.height * tree_unit(tree_hash(t.hash ^ 0x54u));
	t.crown = t.base + vec3(cos(lean_az) * lean_m, t.height, sin(lean_az) * lean_m);
	return t;
}

// Lobe i, in 0..TREE_LOBES-1. Primary p = i / 2, split s = i % 2. Tips fan outward and
// upward from the crown centre; the containment invariant
// |lobe - crown| + lobe_radius <= crown_r is what Task 3's bound and the leaf scatter's
// capacity both rest on, so the reach below is written as a FRACTION of crown_r.
vec3 tree_lobe(Tree t, TreeParams tp, int i) {
	uint h = tree_hash(t.hash ^ (uint(i) * 0x9E3779B9u));
	int p = i / 2;
	// Primaries evenly spaced in azimuth with a per-tree phase, splits offset either side.
	float base_az = 6.2831853 * (float(p) / float(TREE_PRIMARIES)) + tree_unit(t.hash) * 6.2831853;
	float az = base_az + (float(i % 2) * 2.0 - 1.0) * 0.55 + 0.25 * tree_snorm(h);
	// Elevation from just below the horizontal to well above, so the crown is a mass rather
	// than a ring. 0.15..0.85 of a right angle.
	float el = mix(0.15, 0.85, tree_unit(tree_hash(h ^ 0x77u))) * 1.5707963;
	float reach = t.crown_r * mix(0.42, 0.62, tree_unit(tree_hash(h ^ 0x88u)));
	return t.crown + vec3(cos(az) * cos(el), sin(el), sin(az) * cos(el)) * reach;
}

// Sized so |lobe - crown| + radius never exceeds crown_r: reach maxes at 0.62 * crown_r, so
// 0.38 * crown_r is the largest radius that still fits, and the jitter stays under it.
float tree_lobe_radius(Tree t, TreeParams tp, int i) {
	uint h = tree_hash(t.hash ^ (uint(i) * 0x85EBCA6Bu));
	return t.crown_r * mix(0.26, 0.38, tree_unit(h));
}

// Radius of limb i where it leaves the trunk. Limb 0 is the dominant one: real crowns have
// one obvious leader and subordinates, and four limbs of equal thickness is the same mistake
// as ten branches from one point.
//
// FLOORED at branch_radius_min, because a subordinate limb on a slim trunk can otherwise
// compute a fork radius BELOW the tip radius and taper outward -- measured at 0.0883 ->
// 0.0947 m on the first cut of this reshape, which reads as a club rather than a branch.
float tree_limb_radius(Tree t, TreeParams tp, int i) {
	float thick = (i == 0) ? 0.62 : 0.40;
	return max(tree_trunk_radius(t, tree_limb_fork(t, i)) * thick, tp.branch_radius_min * 1.25);
}

// iq's round cone: the exact distance to a capsule tapering from radius ra at a to rb at b.
// Exactly 1-Lipschitz, which is why the union below is a plain min and never a smooth min --
// a polynomial smooth minimum is not, and an overstated field tunnels the raymarcher.
float tree_round_cone(vec3 p, vec3 a, vec3 b, float ra, float rb) {
	vec3 ba = b - a;
	float l2 = dot(ba, ba);
	float rr = ra - rb;
	float a2 = l2 - rr * rr;
	float il2 = 1.0 / max(l2, 1e-8);

	vec3 pa = p - a;
	float y = dot(pa, ba);
	float z = y - l2;
	vec3 w = pa * l2 - ba * y;
	float x2 = dot(w, w);
	float y2 = y * y * l2;
	float z2 = z * z * l2;

	float k = sign(rr) * rr * rr * x2;
	if (sign(z) * a2 * z2 > k) return sqrt(max(x2 + z2, 0.0)) * il2 - rb;
	if (sign(y) * a2 * y2 < k) return sqrt(max(x2 + y2, 0.0)) * il2 - ra;
	return (sqrt(max(x2 * a2 * il2, 0.0)) + y * rr) * il2 - ra;
}

// The whole tree: a curved leaning trunk in TREE_TRUNK_SEGS segments, plus TREE_LIMBS limbs
// that each leave the trunk at their own height and arch out to a canopy lobe. Exact,
// 1-Lipschitz: every piece is iq's round cone and the union is a plain min, never a smooth
// min -- a polynomial smooth minimum is not 1-Lipschitz and an overstated field tunnels.
float tree_skeleton_sdf(vec3 p, Tree t, TreeParams tp) {
	// Trunk. Walk the curve, capsule between consecutive samples.
	float d = 1.0e30;
	vec3 prev = tree_trunk_point(t, 0.0);
	float prev_r = tree_trunk_radius(t, 0.0);
	for (int k = 1; k <= TREE_TRUNK_SEGS; k++) {
		float s = float(k) / float(TREE_TRUNK_SEGS);
		vec3 cur = tree_trunk_point(t, s);
		float cur_r = tree_trunk_radius(t, s);
		d = min(d, tree_round_cone(p, prev, cur, prev_r, cur_r));
		prev = cur;
		prev_r = cur_r;
	}
	// Limbs. Each aims at an EXISTING canopy lobe (tree_lobe, unchanged), so a limb tip
	// always ends inside leaf mass rather than poking out into open air.
	for (int i = 0; i < TREE_LIMBS; i++) {
		float sf = tree_limb_fork(t, i);
		vec3 fork = tree_trunk_point(t, sf);
		vec3 tip = tree_lobe(t, tp, i * 2);
		// Limb 0 is the dominant one. Real crowns have one obvious leader and subordinates;
		// four limbs of equal thickness is the same mistake as ten branches from one point.
		float r0 = tree_limb_radius(t, tp, i);
		float r1 = tp.branch_radius_min;
		float rm = mix(r0, r1, 0.55);
		// The elbow rides above the chord, so a limb sweeps up and then out. Its rise is a
		// fraction of the limb's own length, which keeps it well inside the crown sphere --
		// the containment test in test_tree_shader.cpp is what actually holds this honest.
		vec3 mid = mix(fork, tip, 0.55) + vec3(0.0, length(tip - fork) * 0.18, 0.0);
		d = min(d, tree_round_cone(p, fork, mid, r0, rm));
		d = min(d, tree_round_cone(p, mid, tip, rm, r1));
	}
	return d;
}

// Cheap conservative bound: one capsule from the trunk foot to the crown centre, fattened to
// the crown radius. NEVER greater than tree_skeleton_sdf, so using it as an early-out reject
// cannot drop a cell the skeleton would have claimed.
float tree_bound(vec3 p, Tree t) {
	return tree_round_cone(p, t.base, t.crown, t.crown_r, t.crown_r);
}

// Callers sweep only the 3x3 cell neighbourhood, which OVERESTIMATES the distance when the
// nearest tree is two cells out -- and an overestimate is the direction that tunnels. A tree
// never leaves its own cell's TREE_JITTER box and never reaches past crown_r, so any tree
// outside the swept 3x3 has its surface at least this far away:
//
//     1.5 * cell   the centre-to-centre distance to the nearest UNSWEPT cell's near edge
//   - jitter                          the furthest that tree can have moved toward us
//   - crown_r                                   the furthest its geometry can reach out
//
// Clamping DOWN to that value is conservative. Inside the vertical band the stage runs in,
// the terrain distance is already smaller, so the clamp costs essentially nothing.
float tree_d_safe(TreeParams tp) {
	// The lean term: a leaning crown centre reaches TREE_MAX_LEAN * height further from the
	// cell centre than an upright one, and height itself runs up to 1.25 * trunk_height.
	// Omitting this OVERESTIMATES the distance, which is the direction that tunnels.
	float max_lean = TREE_MAX_LEAN * tp.trunk_height * 1.25;
	return max(0.0, (1.5 - TREE_JITTER) * tp.cell - tp.crown_radius - max_lean);
}
