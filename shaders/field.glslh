// GPU mirror of ve::AnalyticGenerator (extension/src/generator/generator.cpp) and
// ve::apply_op (extension/src/generator/edit_ops.cpp). tests/test_field_diff.gd diffs the
// two and fails when they drift (spec section 8).
//
// The includer MUST include common.glslh first and define FIELD_OP_POOL_BINDING to the
// set-0 binding of its op pool before pulling this file in.

const uint OP_SPHERE_SUBTRACT = 0u;
const uint OP_SPHERE_ADD = 1u;
const uint OP_SPHERE_PAINT = 2u;
const uint OP_BOX_SUBTRACT = 3u;
const uint OP_VOLUME_ADD = 4u;
const uint MAX_REGION_OPS = 256u;
// ve::kOccupancyCellSize -- a box op's extent is counted in 0.8 m occupancy cells.
const float OCCUPANCY_CELL_SIZE = 0.8;
// ve::kIslandDim ^ 3: the per-slot stride of both volume buffers. render/volume_pool.cpp
// static_asserts that this matches, so changing the C++ constant breaks the BUILD.
const int VOLUME_VOXELS = 262144;
// Mirror of ve::kSurfaceY (extension/src/generator/generator.h): 51.2 = -origin_bricks.y *
// kBrickSize for the default world origin (0, -64, 0). Must stay in lockstep with the CPU
// constant; tests/test_field_diff.gd guards the agreement.
const float SURFACE_Y = 51.2;

// ve::EditOp is 32 bytes; storing two uvec4 per op and unpacking by hand keeps the mirror
// exact, because a std430 struct with a vec3 member would silently pad to 48.
//   uvec4 a = { type, material, pos.x, pos.y }
//   uvec4 b = { pos.z, radius, aux0, aux1 }
layout(set = 0, binding = FIELD_OP_POOL_BINDING, std430) readonly buffer FieldOpPool {
	uvec4 v[];
} field_op_pool;

float hills(float x, float z) {
	return 6.0 * sin(x * 0.11) * cos(z * 0.13)
	     + 3.0 * sin(x * 0.031 + 1.7) * sin(z * 0.043)
	     + 1.0 * sin(x * 0.23 + z * 0.19);
}

void base_field(vec3 p, out float sdf, out uint mat) {
	float h = hills(p.x, p.z);
	sdf = p.y - SURFACE_Y - h;
	const float cx = 30.0, cz = 30.0;
	float cy = SURFACE_Y + hills(cx, cz) - 2.0;
	float sphere = length(p - vec3(cx, cy, cz)) - 5.0;
	sdf = max(sdf, -sphere); // CSG subtract: the one carved cave
	mat = 0u;
	if (sdf <= 0.0) mat = h > 4.0 ? 2u : (h > 1.0 ? 1u : 3u);
}

// Mirror of ve::box_sdf (extension/src/generator/edit_ops.cpp).
float op_box_sdf(vec3 lo, vec3 hi, vec3 p) {
	vec3 c = 0.5 * (lo + hi);
	vec3 h = 0.5 * (hi - lo);
	vec3 q = abs(p - c) - h;
	return length(max(q, vec3(0.0))) + min(max(q.x, max(q.y, q.z)), 0.0);
}

// Mirror of ve::box_sdf_gradient (extension/src/generator/edit_ops.cpp).
void op_box_sdf_gradient(vec3 lo, vec3 hi, vec3 p, out vec3 g) {
	vec3 c = 0.5 * (lo + hi);
	vec3 h = 0.5 * (hi - lo);
	vec3 d = p - c;
	vec3 s = vec3(d.x >= 0.0 ? 1.0 : -1.0, d.y >= 0.0 ? 1.0 : -1.0, d.z >= 0.0 ? 1.0 : -1.0);
	vec3 q = abs(d) - h;
	bool outside = q.x > 0.0 || q.y > 0.0 || q.z > 0.0;
	if (outside) {
		vec3 v = vec3(0.0);
		if (q.x > 0.0) v.x = q.x * s.x;
		if (q.y > 0.0) v.y = q.y * s.y;
		if (q.z > 0.0) v.z = q.z * s.z;
		float len = length(v);
		if (len < 1e-6) g = vec3(0.0, 1.0, 0.0);
		else g = v / len;
	} else {
		int best = 0;
		float best_q = q.x;
		if (q.y > best_q) { best_q = q.y; best = 1; }
		if (q.z > best_q) { best_q = q.z; best = 2; }
		g = vec3(0.0);
		g[best] = s[best];
	}
}

void base_field_gradient(vec3 p, out float sdf, out uint mat, out vec3 grad, out bool exact) {
	float h = hills(p.x, p.z);
	float terrain_sdf = p.y - SURFACE_Y - h;
	const float cx = 30.0, cz = 30.0;
	float cy = SURFACE_Y + hills(cx, cz) - 2.0;
	vec3 d = p - vec3(cx, cy, cz);
	float len = length(d);
	float sphere = len - 5.0;
	sdf = max(terrain_sdf, -sphere);
	mat = 0u;
	if (sdf <= 0.0) mat = h > 4.0 ? 2u : (h > 1.0 ? 1u : 3u);
	float dhdx = 0.66 * cos(p.x * 0.11) * cos(p.z * 0.13)
			+ 0.093 * cos(p.x * 0.031 + 1.7) * sin(p.z * 0.043)
			+ 0.23 * cos(p.x * 0.23 + p.z * 0.19);
	float dhdz = -0.78 * sin(p.x * 0.11) * sin(p.z * 0.13)
			+ 0.129 * sin(p.x * 0.031 + 1.7) * cos(p.z * 0.043)
			+ 0.19 * cos(p.x * 0.23 + p.z * 0.19);
	grad = vec3(-dhdx, 1.0, -dhdz);
	exact = true;
	if (-sphere > terrain_sdf) {
		if (len < 1e-6) {
			grad = vec3(0.0, 1.0, 0.0);
			exact = false;
		} else {
			grad = -(d / len);
			exact = true;
		}
	}
}

// The stored-volume pool. Two buffers rather than one so a slot's byte offset is
// slot * VOLUME_VOXELS in BOTH of them: a test can then stand up a one-slot pool without
// knowing how many slots the shipping pool has. Bytes are unpacked by hand out of uint
// words for the same reason ve::EditOp is unpacked by hand -- there is exactly one layout
// rule, and it is written here.
#ifdef FIELD_VOLUME_SDF_BINDING
layout(set = 0, binding = FIELD_VOLUME_SDF_BINDING, std430) readonly buffer FieldVolumeSdf {
	uint w[];
} field_volume_sdf;
layout(set = 0, binding = FIELD_VOLUME_MAT_BINDING, std430) readonly buffer FieldVolumeMat {
	uint w[];
} field_volume_mat;

uint volume_sdf_byte(int i) {
	return (field_volume_sdf.w[i >> 2] >> ((uint(i) & 3u) * 8u)) & 0xFFu;
}
uint volume_mat_byte(int i) {
	return (field_volume_mat.w[i >> 2] >> ((uint(i) & 3u) * 8u)) & 0xFFu;
}

// Mirror of ve::sample_volume_lattice (extension/src/generator/volume_set.cpp), including
// its outside-the-box rule: beyond the lattice the value is the distance TO the lattice box,
// which is a sound lower bound on the distance to anything inside it and therefore cannot
// add material through the union the op performs.
void sample_field_volume(int slot, vec3 origin, float voxel, int dim, vec3 p,
		out float sdf, out uint mat) {
	// A malformed/corrupt op must never drive an out-of-bounds SSBO read or a divide by
	// zero. Fail soft: contribute nothing to the union. The `!(voxel > 0.0)` form rejects
	// NaN as well as zero/negative pitches.
	if (slot < 0 || slot >= 64 || dim < 2 || dim > 64 || !(voxel > 0.0)) {
		sdf = 1e30;
		mat = 0u;
		return;
	}
	float span = float(dim - 1) * voxel;
	vec3 lo = origin, hi = origin + vec3(span);
	float outside = op_box_sdf(lo, hi, p);
	if (outside > 0.0) { sdf = outside; mat = 0u; return; }

	vec3 l = clamp((p - lo) / voxel, vec3(0.0), vec3(float(dim - 1)));
	ivec3 i0 = ivec3(l);
	ivec3 i1 = min(i0 + 1, ivec3(dim - 1));
	vec3 f = l - vec3(i0);
	int base = slot * VOLUME_VOXELS;
	int sy = dim, sz = dim * dim;
	float c000 = decode_sdf(float(volume_sdf_byte(base + i0.x + i0.y * sy + i0.z * sz)) / 255.0);
	float c100 = decode_sdf(float(volume_sdf_byte(base + i1.x + i0.y * sy + i0.z * sz)) / 255.0);
	float c010 = decode_sdf(float(volume_sdf_byte(base + i0.x + i1.y * sy + i0.z * sz)) / 255.0);
	float c110 = decode_sdf(float(volume_sdf_byte(base + i1.x + i1.y * sy + i0.z * sz)) / 255.0);
	float c001 = decode_sdf(float(volume_sdf_byte(base + i0.x + i0.y * sy + i1.z * sz)) / 255.0);
	float c101 = decode_sdf(float(volume_sdf_byte(base + i1.x + i0.y * sy + i1.z * sz)) / 255.0);
	float c011 = decode_sdf(float(volume_sdf_byte(base + i0.x + i1.y * sy + i1.z * sz)) / 255.0);
	float c111 = decode_sdf(float(volume_sdf_byte(base + i1.x + i1.y * sy + i1.z * sz)) / 255.0);
	sdf = mix(mix(mix(c000, c100, f.x), mix(c010, c110, f.x), f.y),
	          mix(mix(c001, c101, f.x), mix(c011, c111, f.x), f.y), f.z);

	// Nearest, not interpolated: a material id is a label and blending two labels is
	// meaningless. Same rule the brick material atlas uses.
	ivec3 m = min(ivec3(l + 0.5), ivec3(dim - 1));
	mat = volume_mat_byte(base + m.x + m.y * sy + m.z * sz);
}

#ifdef FIELD_VOLUME_NORMAL_BINDING
// The compact-normal PAYLOAD: one uint16 oct pair per sample, shared by stored volumes
// AND override bricks. Spans live at dynamically allocated byte offsets published in
// offset tables -- never at a fixed slot stride.
layout(set = 0, binding = FIELD_VOLUME_NORMAL_BINDING, std430) readonly buffer FieldVolumeNormal {
	uint n[];
} field_volume_normal;
#endif
#ifdef FIELD_VOLUME_NORMAL_OFFSET_BINDING
layout(set = 0, binding = FIELD_VOLUME_NORMAL_OFFSET_BINDING, std430) readonly buffer FieldVolumeNormalOffsets {
	int slot[];
} field_volume_normal_offsets;
#endif

// One packed oct pair is TWO bytes, so the pool stores two samples per uint32 word.
// `base` is the word index of a span's start (span byte offset >> 2); `i` is the linear
// SAMPLE index inside that span -- byte address base*4 + 2*i, i.e. word base + (i >> 1),
// low half for even i, high half for odd i. Only compiled where the shared payload is
// declared: the probe/brick/mesh shaders include this file without the normal binding and
// must not see a dangling reference.
#ifdef FIELD_VOLUME_NORMAL_BINDING
uint pool_normal16(int base, int i) {
	uint w = field_volume_normal.n[base + (i >> 1)];
	return (i & 1) != 0 ? (w >> 16) : (w & 0xFFFFu);
}
#endif

#if defined(FIELD_VOLUME_SDF_BINDING) && defined(FIELD_VOLUME_NORMAL_BINDING) && defined(FIELD_VOLUME_NORMAL_OFFSET_BINDING)
bool sample_field_volume_gradient(int slot, vec3 origin, float voxel, int dim, vec3 p,
		out float sdf, out uint mat, out vec3 grad, out bool exact) {
	if (slot < 0 || slot >= 64 || dim < 2 || dim > 64 || !(voxel > 0.0)) return false;
	float span = float(dim - 1) * voxel;
	vec3 lo = origin, hi = origin + vec3(span);
	float vsdf; uint vmat;
	sample_field_volume(slot, origin, voxel, dim, p, vsdf, vmat);
	sdf = vsdf; mat = vmat;
	float outside = op_box_sdf(lo, hi, p);
	if (outside > 0.0) {
		op_box_sdf_gradient(lo, hi, p, grad);
		exact = true;
		return true;
	}
	// The payload is a dynamic span of the shared pool; its 4-aligned byte offset lives
	// in the volume offsets table. -1 means "no normals bound": the caller differentiates
	// the stored SDF instead of reading stale or zero bytes.
	int off = field_volume_normal_offsets.slot[slot];
	if (off < 0) return false;
	int base = off >> 2;
	vec3 l = clamp((p - lo) / voxel, vec3(0.0), vec3(float(dim - 1)));
	ivec3 i0 = ivec3(l);
	ivec3 i1 = min(i0 + 1, ivec3(dim - 1));
	vec3 f = l - vec3(i0);
	int sy = dim, sz = dim * dim;
	vec3 n000 = oct_decode_snorm8(pool_normal16(base, i0.x + i0.y * sy + i0.z * sz));
	vec3 n100 = oct_decode_snorm8(pool_normal16(base, i1.x + i0.y * sy + i0.z * sz));
	vec3 n010 = oct_decode_snorm8(pool_normal16(base, i0.x + i1.y * sy + i0.z * sz));
	vec3 n110 = oct_decode_snorm8(pool_normal16(base, i1.x + i1.y * sy + i0.z * sz));
	vec3 n001 = oct_decode_snorm8(pool_normal16(base, i0.x + i0.y * sy + i1.z * sz));
	vec3 n101 = oct_decode_snorm8(pool_normal16(base, i1.x + i0.y * sy + i1.z * sz));
	vec3 n011 = oct_decode_snorm8(pool_normal16(base, i0.x + i1.y * sy + i1.z * sz));
	vec3 n111 = oct_decode_snorm8(pool_normal16(base, i1.x + i1.y * sy + i1.z * sz));
	vec3 nx00 = mix(n000, n100, f.x);
	vec3 nx10 = mix(n010, n110, f.x);
	vec3 nx01 = mix(n001, n101, f.x);
	vec3 nx11 = mix(n011, n111, f.x);
	vec3 nxy0 = mix(nx00, nx10, f.y);
	vec3 nxy1 = mix(nx01, nx11, f.y);
	vec3 nxyz = mix(nxy0, nxy1, f.z);
	float len = length(nxyz);
	if (len > 1e-6) grad = nxyz / len; else grad = vec3(0.0, 1.0, 0.0);
	exact = true;
	return true;
}
#endif
#endif

#ifdef FIELD_OVERRIDE_SDF_BINDING
layout(set = 0, binding = FIELD_OVERRIDE_SDF_BINDING, std430) readonly buffer FieldOverrideSdf {
	uint w[];
} field_override_sdf;
layout(set = 0, binding = FIELD_OVERRIDE_MAT_BINDING, std430) readonly buffer FieldOverrideMat {
	uint w[];
} field_override_mat;
layout(set = 0, binding = FIELD_OVERRIDE_TABLE_BINDING, std430) readonly buffer FieldOverrideTables {
	int slot[];
} field_override_tables;
layout(set = 0, binding = FIELD_OVERRIDE_REGION_BINDING, std430) readonly buffer FieldOverrideRegionMap {
	int table[];
} field_override_region_map;

uint override_sdf_byte(int i) {
	return (field_override_sdf.w[i >> 2] >> ((uint(i) & 3u) * 8u)) & 0xFFu;
}
uint override_mat_byte(int i) {
	return (field_override_mat.w[i >> 2] >> ((uint(i) & 3u) * 8u)) & 0xFFu;
}

// Forward declaration: sample_field_override_gradient (below) reads the same baked base.
bool sample_field_override(vec3 p, uint op_base, out float sdf, out uint mat);

#ifdef FIELD_NORMAL_OVERRIDE_BINDING
// Binding for the OVERRIDE half of the offsets table. The payload itself is the shared
// FieldVolumeNormal buffer above; this table says where each override brick slot's span
// starts (byte offset, 4-aligned; -1 = no normals bound, fall back to SDF taps).
layout(set = 0, binding = FIELD_NORMAL_OVERRIDE_BINDING, std430) readonly buffer FieldOverrideNormalOffsets {
	int slot[];
} field_override_normal_offsets;
#ifdef FIELD_VOLUME_NORMAL_BINDING
bool sample_field_override_gradient(vec3 p, uint op_base, out float sdf, out uint mat, out vec3 grad, out bool exact) {
	float osdf; uint omat;
	if (!sample_field_override(p, op_base, osdf, omat)) return false;
	int table = FIELD_OVERRIDE_TABLE(op_base);
	if (table < 0 || table >= 32) return false;
	ivec3 brick = ivec3(floor(p / BRICK_SIZE));
	int bi = (brick.x & 31) + (brick.y & 31) * REGION_BRICKS + (brick.z & 31) * REGION_BRICKS * REGION_BRICKS;
	int slot = field_override_tables.slot[table * REGION_BRICK_COUNT + bi];
	if (slot < 0) return false;
	vec3 local = clamp((p - vec3(brick) * BRICK_SIZE) / VOXEL_SIZE, vec3(0.0), vec3(BRICK_SDF_MAX));
	ivec3 i0 = ivec3(floor(local));
	ivec3 i1 = min(i0 + ivec3(1), ivec3(BRICK_VOXELS));
	vec3 f = local - vec3(i0);
	int off = field_override_normal_offsets.slot[slot];
	// The bake exists but no compact-normal span was published for it (offset -1 is the
	// designed fail-soft state from the brief's Step 6). Keep the baked value/material but
	// report an inexact ZERO gradient -- mirror of sample_field_volume_gradient's no-span
	// branch -- so the caller's terrain_source_normal shades through the wide R8 fallback
	// instead of the unedited procedural gradient.
	if (off < 0) { sdf = osdf; mat = omat; grad = vec3(0.0); exact = false; return true; }
	int base = off >> 2;
	int stride = BRICK_SDF_STRIDE;
	vec3 n000 = oct_decode_snorm8(pool_normal16(base, i0.x + i0.y * stride + i0.z * stride * stride));
	vec3 n100 = oct_decode_snorm8(pool_normal16(base, i1.x + i0.y * stride + i0.z * stride * stride));
	vec3 n010 = oct_decode_snorm8(pool_normal16(base, i0.x + i1.y * stride + i0.z * stride * stride));
	vec3 n110 = oct_decode_snorm8(pool_normal16(base, i1.x + i1.y * stride + i0.z * stride * stride));
	vec3 n001 = oct_decode_snorm8(pool_normal16(base, i0.x + i0.y * stride + i1.z * stride * stride));
	vec3 n101 = oct_decode_snorm8(pool_normal16(base, i1.x + i0.y * stride + i1.z * stride * stride));
	vec3 n011 = oct_decode_snorm8(pool_normal16(base, i0.x + i1.y * stride + i1.z * stride * stride));
	vec3 n111 = oct_decode_snorm8(pool_normal16(base, i1.x + i1.y * stride + i1.z * stride * stride));
	vec3 nx00 = mix(n000, n100, f.x);
	vec3 nx10 = mix(n010, n110, f.x);
	vec3 nx01 = mix(n001, n101, f.x);
	vec3 nx11 = mix(n011, n111, f.x);
	vec3 nxy0 = mix(nx00, nx10, f.y);
	vec3 nxy1 = mix(nx01, nx11, f.y);
	vec3 nxyz = mix(nxy0, nxy1, f.z);
	float len = length(nxyz);
	if (len > 1e-6) grad = nxyz / len; else grad = vec3(0.0, 1.0, 0.0);
	sdf = osdf; mat = omat; exact = true;
	return true;
}
#endif
#endif

bool sample_field_override(vec3 p, uint op_base, out float sdf, out uint mat) {
	sdf = 0.0;
	mat = 0u;
	int table = FIELD_OVERRIDE_TABLE(op_base);
	if (table < 0 || table >= 32) return false;
	ivec3 brick = ivec3(floor(p / BRICK_SIZE));
	int bi = (brick.x & 31) + (brick.y & 31) * REGION_BRICKS +
			(brick.z & 31) * REGION_BRICKS * REGION_BRICKS;
	int slot = field_override_tables.slot[table * REGION_BRICK_COUNT + bi];
	if (slot < 0) return false;
	vec3 local = clamp((p - vec3(brick) * BRICK_SIZE) / VOXEL_SIZE,
			vec3(0.0), vec3(BRICK_SDF_MAX));
	ivec3 i0 = ivec3(floor(local));
	ivec3 i1 = min(i0 + ivec3(1), ivec3(BRICK_VOXELS));
	vec3 f = local - vec3(i0);
	int base = slot * 4916;
	int stride = BRICK_SDF_STRIDE;
	int ia = base + i0.x + i0.y * stride + i0.z * stride * stride;
	int ib = base + i1.x + i0.y * stride + i0.z * stride * stride;
	int ic = base + i0.x + i1.y * stride + i0.z * stride * stride;
	int id = base + i1.x + i1.y * stride + i0.z * stride * stride;
	int ie = base + i0.x + i0.y * stride + i1.z * stride * stride;
	int iff = base + i1.x + i0.y * stride + i1.z * stride * stride;
	int ig = base + i0.x + i1.y * stride + i1.z * stride * stride;
	int ih = base + i1.x + i1.y * stride + i1.z * stride * stride;
	float c000 = decode_sdf(float(override_sdf_byte(ia)) / 255.0);
	float c100 = decode_sdf(float(override_sdf_byte(ib)) / 255.0);
	float c010 = decode_sdf(float(override_sdf_byte(ic)) / 255.0);
	float c110 = decode_sdf(float(override_sdf_byte(id)) / 255.0);
	float c001 = decode_sdf(float(override_sdf_byte(ie)) / 255.0);
	float c101 = decode_sdf(float(override_sdf_byte(iff)) / 255.0);
	float c011 = decode_sdf(float(override_sdf_byte(ig)) / 255.0);
	float c111 = decode_sdf(float(override_sdf_byte(ih)) / 255.0);
	sdf = mix(mix(mix(c000, c100, f.x), mix(c010, c110, f.x), f.y),
			mix(mix(c001, c101, f.x), mix(c011, c111, f.x), f.y), f.z);
	ivec3 cell = min(ivec3(floor(local)), ivec3(BRICK_VOXELS - 1));
	int mi = slot * 4096 + cell.x + cell.y * BRICK_VOXELS +
			cell.z * BRICK_VOXELS * BRICK_VOXELS;
	mat = override_mat_byte(mi);
	return true;
}
#endif

// Conservative mirror of ve::op_world_aabb/ve::op_touches_aabb. The box clearance
// margin is intentionally not part of the op AABB: the CPU range calculation uses the
// same activation and lattice pads around this stored box.
bool op_touches_aabb(uint index, vec3 lo, vec3 hi, float pad) {
	uvec4 a = field_op_pool.v[index * 2u + 0u];
	uvec4 b = field_op_pool.v[index * 2u + 1u];
	uint type = a.x;
	vec3 c = vec3(uintBitsToFloat(a.z), uintBitsToFloat(a.w), uintBitsToFloat(b.x));
	float radius = uintBitsToFloat(b.y);
	vec3 op_lo;
	vec3 op_hi;
	if (type == OP_BOX_SUBTRACT) {
		vec3 n = vec3(float(b.z & 0x3FFu), float((b.z >> 10) & 0x3FFu),
				float((b.z >> 20) & 0x3FFu));
		op_lo = c;
		op_hi = c + n * OCCUPANCY_CELL_SIZE;
	} else if (type == OP_VOLUME_ADD) {
		float span = float(int(b.w) - 1) * radius;
		op_lo = c;
		op_hi = c + vec3(span);
	} else {
		op_lo = c - vec3(radius);
		op_hi = c + vec3(radius);
	}
	for (int axis = 0; axis < 3; axis++) {
		if (op_lo[axis] - pad > hi[axis]) return false;
		if (op_hi[axis] + pad < lo[axis]) return false;
	}
	return true;
}

void apply_field_op(uint index, vec3 p, inout float sdf, inout uint mat) {
	uvec4 a = field_op_pool.v[index * 2u + 0u];
	uvec4 b = field_op_pool.v[index * 2u + 1u];
	uint type = a.x;
	uint material = a.y;
	vec3 c = vec3(uintBitsToFloat(a.z), uintBitsToFloat(a.w), uintBitsToFloat(b.x));
	float radius = uintBitsToFloat(b.y);

	if (type == OP_BOX_SUBTRACT) {
		// aux[0] packs the cell extent as 3 x 10 bits (ve::pack_extent3). `radius` carries
		// ve's clearance margin (0 for a plain op): it expands the carved box inside the
		// evaluator only, so the cell-aligned faces of an island carve read as air instead
		// of the exact SDF == 0 a cell-boundary CSG difference leaves behind -- which the
		// cell-aligned lattices (brick, mesh, occupancy) would otherwise mesh as phantom
		// walls inside the carved region. Mirror of ve::apply_op's kOpBoxSubtract.
		vec3 n = vec3(float(b.z & 0x3FFu), float((b.z >> 10) & 0x3FFu),
		              float((b.z >> 20) & 0x3FFu));
		float m = max(radius, 0.0);
		float bd = op_box_sdf(c - vec3(m), c + n * OCCUPANCY_CELL_SIZE + vec3(m), p);
		if (-bd > sdf) { sdf = -bd; if (sdf > 0.0) mat = 0u; }
		return;
	}
	if (type == OP_VOLUME_ADD) {
#ifdef FIELD_VOLUME_SDF_BINDING
		// aux[0] = slot, aux[1] = lattice dimension; radius carries the voxel pitch.
		float vd;
		uint vm;
		sample_field_volume(int(b.z), c, radius, int(b.w), p, vd, vm);
		if (vd < sdf) { sdf = vd; if (sdf <= 0.0 && vm != 0u) mat = vm; }
#endif
		return;
	}

	// Removal hardness has already been resolved into the stored radius. All field samples
	// consume one ordinary sphere, independent of the material at p.
	float sp = length(p - c) - radius;
	if (type == OP_SPHERE_SUBTRACT) {
		if (-sp > sdf) { sdf = -sp; if (sdf > 0.0) mat = 0u; }
	} else if (type == OP_SPHERE_ADD) {
		if (sp < sdf) { sdf = sp; if (sdf <= 0.0) mat = material; }
	} else if (type == OP_SPHERE_PAINT) {
		if (sp <= 0.0 && sdf <= 0.0) mat = material;
	}
}

// How a caller names the pool index of its i-th op. The default is the region's list in
// order; a caller that has pre-filtered the list into shared memory redefines this BEFORE
// including this file, and passes its own count. There is exactly one loop either way.
#ifndef FIELD_OP_INDEX
#define FIELD_OP_INDEX(base, i) ((base) + (i))
#endif

// op_base is the index of the region's first op in the pool (region_slot * MAX_REGION_OPS).
void eval_field(vec3 p, uint op_base, uint op_count, out float sdf, out uint mat) {
#ifdef FIELD_OVERRIDE_SDF_BINDING
	if (!sample_field_override(p, op_base, sdf, mat)) base_field(p, sdf, mat);
#else
	base_field(p, sdf, mat);
#endif
	for (uint i = 0u; i < op_count; i++)
		apply_field_op(FIELD_OP_INDEX(op_base, i), p, sdf, mat);
}

void apply_field_op_gradient(uint index, vec3 p, inout float sdf, inout uint mat, inout vec3 grad, inout bool exact) {
	uvec4 a = field_op_pool.v[index * 2u + 0u];
	uvec4 b = field_op_pool.v[index * 2u + 1u];
	uint type = a.x;
	uint material = a.y;
	vec3 c = vec3(uintBitsToFloat(a.z), uintBitsToFloat(a.w), uintBitsToFloat(b.x));
	float radius = uintBitsToFloat(b.y);
	if (type == OP_BOX_SUBTRACT) {
		vec3 n = vec3(float(b.z & 0x3FFu), float((b.z >> 10) & 0x3FFu), float((b.z >> 20) & 0x3FFu));
		float m = max(radius, 0.0);
		float bd = op_box_sdf(c - vec3(m), c + n * OCCUPANCY_CELL_SIZE + vec3(m), p);
		if (-bd > sdf) {
			sdf = -bd;
			if (sdf > 0.0) mat = 0u;
			vec3 g;
			op_box_sdf_gradient(c - vec3(m), c + n * OCCUPANCY_CELL_SIZE + vec3(m), p, g);
			grad = -g;
			exact = true;
		}
		return;
	}
	if (type == OP_VOLUME_ADD) {
#ifdef FIELD_VOLUME_SDF_BINDING
#if defined(FIELD_VOLUME_NORMAL_BINDING) && defined(FIELD_VOLUME_NORMAL_OFFSET_BINDING)
		float gvd; uint gvm; vec3 gvg; bool gve;
		if (sample_field_volume_gradient(int(b.z), c, radius, int(b.w), p, gvd, gvm, gvg, gve)) {
			if (gvd < sdf) { sdf = gvd; if (sdf <= 0.0 && gvm != 0u) mat = gvm; grad = gvg; exact = gve; }
			return;
		}
		// No compact-normal span for this slot: fall through to the plain sample below, which
		// contributes the stored SDF with an inexact gradient -- mirror of
		// ve::apply_op_gradient's no-normals branch. The caller's R8 fallback then shades.
#endif
		float vd; uint vm;
		sample_field_volume(int(b.z), c, radius, int(b.w), p, vd, vm);
		if (vd < sdf) { sdf = vd; if (sdf <= 0.0 && vm != 0u) mat = vm; grad = vec3(0.0); exact = false; }
#endif
		return;
	}
	float sp = length(p - c) - radius;
	if (type == OP_SPHERE_SUBTRACT) {
		if (-sp > sdf) {
			vec3 d = p - c; float len = length(d);
			vec3 g; bool e;
			if (len < 1e-6) { g = vec3(0.0, 1.0, 0.0); e = false; }
			else { g = d / len; e = true; }
			sdf = -sp; if (sdf > 0.0) mat = 0u; grad = -g; exact = e; if (!e) grad = vec3(0.0, 1.0, 0.0);
		}
	} else if (type == OP_SPHERE_ADD) {
		if (sp < sdf) {
			vec3 d = p - c; float len = length(d);
			vec3 g; bool e;
			if (len < 1e-6) { g = vec3(0.0, 1.0, 0.0); e = false; }
			else { g = d / len; e = true; }
			sdf = sp; if (sdf <= 0.0) mat = material; grad = g; exact = e; if (!e) grad = vec3(0.0, 1.0, 0.0);
		}
	} else if (type == OP_SPHERE_PAINT) {
		if (sp <= 0.0 && sdf <= 0.0) mat = material;
	}
}

void eval_field_gradient(vec3 p, uint op_base, uint op_count, out float sdf, out uint mat, out vec3 grad, out bool exact) {
#ifdef FIELD_OVERRIDE_SDF_BINDING
#ifdef FIELD_NORMAL_OVERRIDE_BINDING
	vec3 og; bool oe;
	if (sample_field_override_gradient(p, op_base, sdf, mat, og, oe)) { grad = og; exact = oe; } else { base_field_gradient(p, sdf, mat, grad, exact); }
#else
	if (!sample_field_override(p, op_base, sdf, mat)) base_field_gradient(p, sdf, mat, grad, exact); else { grad = vec3(0.0); exact = false; }
#endif
#else
	base_field_gradient(p, sdf, mat, grad, exact);
#endif
	for (uint i = 0u; i < op_count; i++)
		apply_field_op_gradient(FIELD_OP_INDEX(op_base, i), p, sdf, mat, grad, exact);
}
