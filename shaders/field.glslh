// Fallback field: compiled only when no terrain-pipeline override is installed (fresh
// import, pipeline load failure). At world init VoxelWorld::load_terrain_pipeline()
// overrides this file WHOLESALE at runtime through ve::set_shader_source_override with
// ve::generate_field_glslh output, which declares set 1 (params UBO b0, sector map b1,
// sampled resources from b2) and defines eval_base_field from the pipeline's stages.
//
// This stub mirrors that shape: the empty-pipeline set-1 layout below (one vec4 of params,
// one -1 sector slot) so every field-consuming pass binds set 1 unconditionally, and an
// eval_base_field holding the hardcoded hills and cave the engine shipped with (the same
// field ve::ProceduralFieldGenerator samples, which the store falls back to on load
// failure). SURFACE_Y and the op constants live in common.glslh so both this stub and
// the generated source get them from one place.
//
// The includer MUST include common.glslh first, exactly as with the generated source.

// eval_base_field is defined below, but field_ops.glslh's eval_field (and its
// base_field_gradient) call it, so it is forward-declared before the include.
void eval_base_field(vec3 p, out float sdf, out uint mat);

// Empty-pipeline set 1: one zeroed vec4 of params (the generator emits `_unused` when a
// pipeline declares no params) and one int sector map holding -1, "no sector resident".
layout(set = 1, binding = 0, std140) uniform FieldParams {
	vec4 _unused;
} P;

layout(set = 1, binding = 1, std430) readonly buffer SectorMap {
	int slot[];
} sector_map;

#include "field_ops.glslh"

float hills(float x, float z) {
	return 6.0 * sin(x * 0.11) * cos(z * 0.13)
	     + 3.0 * sin(x * 0.031 + 1.7) * sin(z * 0.043)
	     + 1.0 * sin(x * 0.23 + z * 0.19);
}

void eval_base_field(vec3 p, out float sdf, out uint mat) {
	float h = hills(p.x, p.z);
	sdf = p.y - SURFACE_Y - h;
	const float cx = 30.0, cz = 30.0;
	float cy = SURFACE_Y + hills(cx, cz) - 2.0;
	float sphere = length(p - vec3(cx, cy, cz)) - 5.0;
	sdf = max(sdf, -sphere); // CSG subtract: the one carved cave
	mat = 0u;
	if (sdf <= 0.0) mat = h > 4.0 ? 2u : (h > 1.0 ? 1u : 3u);
}
