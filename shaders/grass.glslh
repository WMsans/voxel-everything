// Shared grass definitions: the GrassParams layout and the per-blade hash.
// The GrassParams field list is GRASS_PARAMS_FIELDS in shaders/generated/blocks.glslh,
// generated from ve::GrassParams.
//
// NOTE: never put a literal include directive inside a comment in this file -- the loader
// matches include tokens anywhere in a line and would self-include.

#include "generated/blocks.glslh"

struct GrassBlade {
	vec4 a; // xyz world position, w height
	vec4 b; // x ground normal (low 16 bits) + sun visibility byte, y hash as float bits,
	        // z lean angle, w clump weight -- see grass_pack_ground()
};

// PCG-style integer hash. Deterministic in world space, so a blade keeps its identity as
// the camera moves and the field does not shimmer.
uint grass_hash(uint x) {
	x = x * 747796405u + 2891336453u;
	uint w = ((x >> ((x >> 28u) + 4u)) ^ x) * 277803737u;
	return (w >> 22u) ^ w;
}

uint grass_hash3(ivec3 c, uint salt) {
	return grass_hash(uint(c.x) * 73856093u ^ uint(c.y) * 19349663u ^
			uint(c.z) * 83492791u ^ salt);
}

float grass_unit(uint h) { return float(h & 0x00FFFFFFu) / float(0x01000000u); }

// Signed unit in -1..1, for anything that scatters symmetrically about a centre.
float grass_snorm(uint h) { return grass_unit(h) * 2.0 - 1.0; }

// Far rings halve their blade count (grass_layout.cpp), so without this the field would
// visibly thin with distance. Width grows exp2 in the reach fraction by the same factor the
// count shrinks, which holds COVERAGE flat: fewer, fatter blades read as the same meadow.
// Continuous in distance rather than stepped per ring, so no banding appears at a ring edge.
//
// Past `reach_m` the blade is in a far LoD ring, whose cell size DOUBLES every ring
// (GrassSettings::far_lod_rings). The second factor widens it in exact proportion to the
// LoD it was scattered at -- ring 1 twice, ring 2 four times, ring 3 eight -- which is what
// keeps a blade the same width ON SCREEN however far out it stands, instead of letting the
// coarser rings read as scattered spikes over bare ground. It is linear in distance rather
// than stepped per ring for the same reason the near ramp is: a step would band at the seam.
float grass_width_scale(float distance_m, float reach_m, float gain) {
	float r = max(reach_m, 1e-3);
	return exp2(clamp(distance_m / r, 0.0, 1.0) * gain) * max(1.0, distance_m / r);
}

// True when the brick's world-space AABB is outside any frustum plane.
bool grass_brick_culled(vec3 lo, vec3 hi, vec4 planes[6]) {
	for (int i = 0; i < 6; i++) {
		vec3 p = mix(lo, hi, step(vec3(0.0), planes[i].xyz));
		if (dot(planes[i].xyz, p) + planes[i].w < 0.0) return true;
	}
	return false;
}

// Value noise on a world-XZ lattice, scrolled along the wind direction. This is the gust
// field -- the light and dark waves crossing a meadow -- and it is deliberately procedural
// rather than a texture so the pass needs no asset and no extra binding.
float grass_gust(vec2 world_xz, float time, float speed, float scale) {
	vec2 p = world_xz * scale - vec2(0.7, 0.7) * (time * speed);
	vec2 i = floor(p);
	vec2 f = fract(p);
	f = f * f * (3.0 - 2.0 * f);
	float a = grass_unit(grass_hash3(ivec3(i, 0.0), 0x1234u));
	float b = grass_unit(grass_hash3(ivec3(i + vec2(1, 0), 0.0), 0x1234u));
	float c = grass_unit(grass_hash3(ivec3(i + vec2(0, 1), 0.0), 0x1234u));
	float d = grass_unit(grass_hash3(ivec3(i + vec2(1, 1), 0.0), 0x1234u));
	return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);
}
