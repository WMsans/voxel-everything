[node name="Hint" type="Label" parent="Center/Panel/Margin/Box"]
unique_name_in_owner = true
custom_minimum_size = Vector2(480, 0)
layout_mode = 2
text = "Near-field resolution is the fraction of the internal 3D resolution the raymarcher runs at; the composite upsamples its G-buffer back to full size. Below 100% the terrain silhouette is resolved on that coarser grid, which is what the stepped pixels along terrain edges are. Raise it to lose them, lower it to buy frame time."
