#!/usr/bin/env python
import os
import platform

# godot-cpp master requires an explicit api_version to generate bindings (engine is 4.7.x).
api_version = "4.7"
env = SConscript("godot-cpp/SConstruct", exports="api_version")
env.Append(CPPPATH=["src/"])
sources = Glob("src/*.cpp") + Glob("src/*/*.cpp") + Glob("src/*/*/*.cpp")
lib = env.SharedLibrary("bin/voxel_everything{}{}".format(env["suffix"], env["SHLIBSUFFIX"]), source=sources)
Default(lib)

# --- deterministic floating point for the characterization corpora ---
# tests/golden/field_baseline.txt and brick_baseline.txt pin raw float bits, and were
# captured on arm64, where the default -ffp-contract=on fuses `a * b + c` into a single
# fmadd. Baseline x86-64 has no FMA instruction, so the identical source rounds
# differently in the last ULP (measured: 345/640 corpus coordinates and 309/640 SDFs,
# plus every brick hash) and every bit-exact comparison fails. Pin the same contraction
# rule on every compiler and enable FMA on x86-64 so both architectures agree.
_fp_contract_flags = ["-ffp-contract=on"]
if platform.machine() in ("x86_64", "AMD64"):
    _fp_contract_flags.append("-mfma")

# --- native test runner: pure C++ cores only, zero godot-cpp ---
test_env = Environment(CXX=os.environ.get("CXX", "g++"))
test_env.Append(CXXFLAGS=["-std=c++20", "-O1", "-g", "-Wall", "-Wextra", "-pthread"] + _fp_contract_flags)
test_env.Append(LINKFLAGS=["-pthread"])
test_env.Append(CPPPATH=["src", "third_party"])
pure_sources = (Glob("src/world/*.cpp") + Glob("src/generator/*.cpp") +
                Glob("src/core/*.cpp") + Glob("src/terrain/*.cpp") +
                Glob("src/mesh/*.cpp") + Glob("src/connectivity/*.cpp") +
                Glob("src/lod/*.cpp") + Glob("src/shade/*.cpp") +
                Glob("src/grass/*.cpp"))
for f in ["src/render/shader_loader.cpp", "src/render/camera_params.cpp",
          "src/render/frame_params.cpp", "src/render/island_handoff.cpp"]:
    if os.path.exists(f):
        pure_sources.append(f)
# ConsolidationCoordinator publishes GPU transactions by design (godot-cpp headers, worker
# submission); it is not a pure core and cannot compile in the zero-godot-cpp test build.
# Same for LodSystem (Task 15): ensure_lod()/tick() drive GPU pools and raster passes.
pure_sources = [s for s in pure_sources
                if str(s) not in ("src/mesh/consolidation.cpp", "src/lod/lod_system.cpp")]
test_env.Append(CPPDEFINES=[("VE_REPO_ROOT", '\\"' + Dir("#").abspath + '/..\\"')])
tests = test_env.Program("build/tests/ve_tests", Glob("tests/*.cpp") + pure_sources)
test_alias = Alias("test", [tests], tests[0].abspath)
AlwaysBuild(test_alias)
