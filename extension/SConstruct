#!/usr/bin/env python
import os

# godot-cpp master requires an explicit api_version to generate bindings (engine is 4.7.x).
api_version = "4.7"
env = SConscript("godot-cpp/SConstruct", exports="api_version")
env.Append(CPPPATH=["src/"])
sources = Glob("src/*.cpp") + Glob("src/*/*.cpp")
lib = env.SharedLibrary("bin/voxel_everything{}{}".format(env["suffix"], env["SHLIBSUFFIX"]), source=sources)
Default(lib)

# --- native test runner: pure C++ cores only, zero godot-cpp ---
test_env = Environment(CXX=os.environ.get("CXX", "g++"))
test_env.Append(CXXFLAGS=["-std=c++20", "-O1", "-g", "-Wall", "-Wextra"])
test_env.Append(CPPPATH=["src", "third_party"])
pure_sources = (Glob("src/world/*.cpp") + Glob("src/generator/*.cpp") +
                Glob("src/core/*.cpp") +
                Glob("src/mesh/*.cpp") + Glob("src/connectivity/*.cpp") +
                Glob("src/lod/*.cpp") + Glob("src/shade/*.cpp"))
for f in ["src/render/shader_loader.cpp", "src/render/camera_params.cpp"]:
    if os.path.exists(f):
        pure_sources.append(f)
# ConsolidationCoordinator publishes GPU transactions by design (godot-cpp headers, worker
# submission); it is not a pure core and cannot compile in the zero-godot-cpp test build.
pure_sources = [s for s in pure_sources if str(s) != "src/mesh/consolidation.cpp"]
tests = test_env.Program("build/tests/ve_tests", Glob("tests/*.cpp") + pure_sources)
test_alias = Alias("test", [tests], tests[0].abspath)
AlwaysBuild(test_alias)
